{
  "name": "simplememo",
  "version": "1.1.0",
  "description": "Electron製のシンプルなメモ帳",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron ./src/main.js",
    "build": "electron-builder --win --x64",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "build": {
    "extends": null,
    "extraMetadata": {
      "main": "./src/main.js"
    },
    "appId": "com.electron.SimpleMemo",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        "7z",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SimpleMemo"
    }
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "electron": "^44.2.0",
    "electron-builder": "^26.7.0",
    "eslint": "^9.39.5",
    "globals": "^17.12.0"
  },
  "dependencies": {
    "encoding-japanese": "^2.2.0",
    "legally": "^3.5.10",
    "license-checker": "^25.0.1",
    "mousetrap": "^1.6.5"
  }
}
